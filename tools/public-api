"""Update or check the workspace's public Rust API listings."""

import argparse
import difflib
import subprocess
import sys
from tempfile import TemporaryDirectory

from workspace import ROOT, WASM_TARGET, wasm_exclusions, workspace_members, workspace_metadata

LISTINGS = ROOT / "docs" / "api"
# rustdoc JSON is unstable. Install this version with --install-toolchain.
NIGHTLY = "nightly-2026-11-22"
LIBRARY_KINDS = {"lib", "rlib", "dylib", "cdylib", "staticlib", "proc-macro"}


def listings(target_dir):
    metadata = workspace_metadata()
    excluded = set(wasm_exclusions(metadata))
    for package in sorted(workspace_members(metadata), key=lambda package: package["name"]):
        if not any(LIBRARY_KINDS.intersection(target["kind"]) for target in package["targets"]):
            continue
        name = package["name"]
        targets = [("", [])]
        if name not in excluded:
            targets.append((f".{WASM_TARGET}", ["--target", WASM_TARGET]))
        for target_suffix, target_args in targets:
            for feature_suffix, feature_args in (("", ["--all-features"]), (".default", [])):
                output = subprocess.check_output(
                    ["cargo", f"+{NIGHTLY}", "public-api", "--color", "never",
                     "--target-dir", target_dir,
                     "--manifest-path", package["manifest_path"], *target_args, *feature_args],
                    cwd=ROOT,
                    text=True,
                )
                yield LISTINGS / f"{name}{target_suffix}{feature_suffix}.txt", output


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true", help="fail on missing or changed listings")
    mode.add_argument("--install-toolchain", action="store_true", help="install the API toolchain")
    args = parser.parse_args()
    if args.install_toolchain:
        subprocess.run(
            ["rustup", "toolchain", "install", NIGHTLY, "--profile", "minimal",
             "--target", WASM_TARGET],
            check=True,
        )
        return 0

    # mise can run cargo doc and API checks at the same time.
    with TemporaryDirectory(prefix="ccc-public-api-") as target_dir:
        generated = dict(listings(target_dir))
    outdated = False
    for path in sorted(set(generated) | set(LISTINGS.glob("*.txt"))):
        expected = generated.get(path)
        if not args.check:
            if expected is None:
                path.unlink()
            else:
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text(expected, encoding="utf-8")
            continue

        current = path.read_text(encoding="utf-8") if path.exists() else None
        if expected != current:
            outdated = True
            name = path.relative_to(ROOT)
            print(f"{name} is out of date.", file=sys.stderr)
            sys.stderr.writelines(difflib.unified_diff(
                (current or "").splitlines(keepends=True),
                (expected or "").splitlines(keepends=True),
                fromfile=f"committed/{name}",
                tofile=f"generated/{name}",
            ))

    if outdated:
        print("Run 'mise run update:api' and commit the resulting listings.", file=sys.stderr)
    return int(outdated)


if __name__ == "__main__":
    sys.exit(main())
