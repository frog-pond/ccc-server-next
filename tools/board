#!/usr/bin/env python3
"""Prints the state of the rearchitecture: every issue under the parent issue
with its status, priority, size, estimate in hours, pull request, what it is
waiting on and, when it is ready to start, the branch to start it from. Then
the open pull requests whose branches follow the naming rule.

Priority is the organisation's issue field (Urgent, High, Medium, Low). Size
and Estimate are fields of the project. All three are the maintainer's.

Usage:
  tools/board [--json]
  tools/board --help                    print this text, including the rules
  tools/board status <issue> <status>   set an issue's status on the project board
  tools/board maintain [--apply]        propose (or, with --apply, make) the board
                                        moves the rules below call for, and list
                                        what needs a person's judgment

An issue is ready when it is open, has no sub-issues and no pull request of
its own, has a status of "Backlog", "Ready" or none, and every issue that blocks it
is closed, has merged its pull request into `rearchitecture`, or has one open
pull request that is not a draft, with all such pull requests on one chain of
branches. The branch to start from is then the highest of those pull
requests' branches, or `rearchitecture` when every blocker is closed.

Only branches named `rearch/<issue>-<name>` are considered, and only pull
requests whose base is `rearchitecture` or another such branch.

The status each issue should have, which `maintain` applies:
  - closed: Done;
  - open, with its own open pull request: In review, or In progress while the
    pull request is a draft;
  - open, without one, and not yet started (Backlog, Ready or none): Ready when
    it is ready as defined above, otherwise Backlog;
  - open, with sub-issues: In progress once any sub-issue has been started or
    finished, otherwise Backlog.
`maintain` also adds issues under the parent to the board, assigns the
maintainer where nobody is assigned, and puts an issue that becomes Ready or
starts into the current iteration when it has none. It never closes or reopens
an issue, never moves an issue that is in progress without a pull request, and
never touches draft items; it reports those instead.

Needs the GitHub CLI (`gh`) signed in with the `project` scope.
"""

import datetime
import json
import re
import subprocess
import sys

REPO = "frog-pond/ccc-server-next"
OWNER = "frog-pond"
PROJECT = 4
PARENT = 424
BASE = "rearchitecture"
MAINTAINER = "rye"
BRANCH = re.compile(r"^rearch/(\d+)-")
STARTED = {"In progress", "In review", "Done"}
NOT_STARTED = {"-", "Backlog", "Ready"}


def gh(*args):
	result = subprocess.run(["gh", *args], capture_output=True, text=True)
	if result.returncode != 0:
		err = result.stderr.strip()
		hint = network_hint(err, "check `gh auth status` (the `project` scope is needed)")
		sys.exit(f"gh {' '.join(args[:3])} failed: {err}{hint}")
	return json.loads(result.stdout) if result.stdout.strip() else None


def network_hint(err, otherwise):
	"""A line to add to an error from `gh` or `git` when it looks like GitHub
	could not be reached, which in a sandbox usually means no network access."""
	lowered = err.lower()
	if "unknown owner type" in err or "connect" in lowered or "resolve" in lowered:
		return ("\nGitHub could not be reached. In a sandbox, give this command network access;"
			f" otherwise {otherwise}.")
	return ""


def sub_issues(number, depth=0, seen=None):
	"""Every issue under `number`, depth first, with its depth and parent."""
	seen = set() if seen is None else seen
	found = []
	for child in gh("api", f"repos/{REPO}/issues/{number}/sub_issues", "--paginate") or []:
		if child["number"] in seen:
			continue
		seen.add(child["number"])
		found.append((child, depth, number))
		found.extend(sub_issues(child["number"], depth + 1, seen))
	return found


def priorities(numbers):
	"""Each issue's Priority (Urgent, High, Medium or Low), keyed by number.

	Priority is an issue field set for the whole organisation, not a field of
	the project, so `gh project item-list` does not return it. Issues without
	one are left out. GitHub allows at most 25 fields on an issue, so one page
	of 25 holds them all. Like the rest of this tool, it assumes every issue
	under the parent is in `REPO`."""
	found = {}
	numbers = sorted(set(numbers))
	for start in range(0, len(numbers), 50):
		chunk = numbers[start:start + 50]
		aliases = " ".join(
			f"i{n}:issue(number:{n}){{issueFieldValues(first:25){{nodes{{"
			"... on IssueFieldSingleSelectValue{name field{... on IssueFieldSingleSelect{name}}}}}}"
			for n in chunk
		)
		owner, name = REPO.split("/")
		data = gh("api", "graphql", "-f", f'query={{repository(owner:"{owner}",name:"{name}"){{{aliases}}}}}')
		for n in chunk:
			issue = (data["data"]["repository"] or {}).get(f"i{n}") or {}
			for value in (issue.get("issueFieldValues") or {}).get("nodes") or []:
				if (value.get("field") or {}).get("name") == "Priority":
					found[n] = value["name"]
	return found


def checks(pull):
	states = {c.get("conclusion") or c.get("status") or c.get("state") for c in pull.get("statusCheckRollup") or []}
	if not states:
		return "none"
	if states & {"FAILURE", "ERROR", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED", "STARTUP_FAILURE"}:
		return "failing"
	if states <= {"SUCCESS", "NEUTRAL", "SKIPPED"}:
		return "passing"
	return "running"


def board_items():
	return gh("project", "item-list", str(PROJECT), "--owner", OWNER, "--limit", "500", "--format", "json")["items"]


def project_fields():
	"""The project's id, its Status field and options, and its Iteration field
	with the iteration covering today, if any."""
	project = gh("project", "view", str(PROJECT), "--owner", OWNER, "--format", "json")["id"]
	fields = gh("project", "field-list", str(PROJECT), "--owner", OWNER, "--format", "json")["fields"]
	status = next((f for f in fields if f["name"] == "Status"), None)
	if status is None:
		sys.exit("the project has no Status field")
	iteration = next((f for f in fields if f["name"] == "Iteration"), None)
	current = None
	if iteration is not None:
		data = gh("api", "graphql", "-f", "query=query($owner:String!,$number:Int!){organization(login:$owner)"
			"{projectV2(number:$number){field(name:\"Iteration\"){... on ProjectV2IterationField"
			"{configuration{iterations{id title startDate duration}}}}}}}",
			"-f", f"owner={OWNER}", "-F", f"number={PROJECT}")
		today = datetime.date.today()
		for it in data["data"]["organization"]["projectV2"]["field"]["configuration"]["iterations"]:
			start = datetime.date.fromisoformat(it["startDate"])
			if start <= today < start + datetime.timedelta(days=it["duration"]):
				current = it
	return {
		"project": project,
		"status_field": status["id"],
		"status_options": {o["name"]: o["id"] for o in status.get("options", [])},
		"iteration_field": iteration["id"] if iteration else None,
		"current_iteration": current,
	}


def set_status(number, status):
	"""Sets `number`'s Status field on the project board."""
	fields = project_fields()
	if status not in fields["status_options"]:
		sys.exit(f"unknown status {status!r}; one of: {', '.join(fields['status_options'])}")
	item = next((i for i in board_items() if i.get("content", {}).get("number") == number
		and i.get("content", {}).get("repository") == REPO), None)
	if item is None:
		sys.exit(f"#{number} is not on the project board")
	edit_status(fields, item["id"], status)
	print(f"#{number}: {status}")


def edit_status(fields, item_id, status):
	subprocess.run(["gh", "project", "item-edit", "--project-id", fields["project"], "--id", item_id,
		"--field-id", fields["status_field"], "--single-select-option-id", fields["status_options"][status]],
		check=True, capture_output=True)


def collect():
	"""Reads the board, the issues under the parent and the pull requests, and
	works out each issue's readiness."""
	items = board_items()
	board = {}
	others = []
	for item in items:
		content = item.get("content", {})
		if content.get("number") and content.get("repository") == REPO:
			board[content["number"]] = item
		else:
			others.append(item)

	pulls = gh(
		"pr", "list", "-R", REPO, "--state", "open", "--limit", "200",
		"--json", "number,title,headRefName,baseRefName,isDraft,reviewDecision,statusCheckRollup",
	)
	stack = [
		p for p in pulls
		if BRANCH.match(p["headRefName"]) and (p["baseRefName"] == BASE or BRANCH.match(p["baseRefName"]))
	]
	merged = gh(
		"pr", "list", "-R", REPO, "--state", "merged", "--base", BASE, "--limit", "500",
		"--json", "number,headRefName",
	)
	merged_issues = {int(BRANCH.match(p["headRefName"]).group(1)) for p in merged if BRANCH.match(p["headRefName"])}
	by_head = {p["headRefName"]: p for p in stack}
	by_issue = {}
	for pull in stack:
		by_issue.setdefault(int(BRANCH.match(pull["headRefName"]).group(1)), []).append(pull)

	def chain(head):
		"""The branches from `head` down to `rearchitecture`, or None if the
		chain does not reach it through open pull requests."""
		seen = []
		while head != BASE:
			if head in seen or head not in by_head:
				return None
			seen.append(head)
			head = by_head[head]["baseRefName"]
		return seen

	def base_for(blockers):
		"""The branch to start from, or None with the reason it cannot start."""
		heads = []
		for blocker in blockers:
			if blocker["state"] != "open":
				continue
			own = by_issue.get(blocker["number"], [])
			if not own and blocker["number"] in merged_issues:
				continue
			if not own:
				return None, f"#{blocker['number']} has no pull request"
			if len(own) > 1:
				return None, f"#{blocker['number']} has several pull requests"
			if own[0]["isDraft"]:
				return None, f"#{blocker['number']} is a draft"
			heads.append(own[0]["headRefName"])
		if not heads:
			return BASE, None
		chains = {head: chain(head) for head in heads}
		if any(c is None for c in chains.values()):
			return None, "a blocker's pull request does not reach rearchitecture"
		# Usable only if every blocker's branch lies on the chain of one of them.
		for head, below in chains.items():
			if all(other in below for other in heads):
				return head, None
		return None, "blockers are on separate branches"

	rows = []
	tree = sub_issues(PARENT)
	priority = priorities([issue["number"] for issue, _, _ in tree])
	for issue, depth, parent in tree:
		number = issue["number"]
		blockers = gh("api", f"repos/{REPO}/issues/{number}/dependencies/blocked_by") or []
		item = board.get(number, {})
		status = item.get("status") or "-"
		base, reason = base_for(blockers)
		open_blockers = [b["number"] for b in blockers if b["state"] == "open"]
		has_children = (issue.get("sub_issues_summary") or {}).get("total", 0) > 0
		if has_children and reason is None:
			reason = "has sub-issues; work those"
		ready = (
			issue["state"] == "open"
			and not has_children
			and number not in by_issue
			and status in NOT_STARTED
			and base is not None
		)
		rows.append({
			"number": number,
			"depth": depth,
			"parent": parent,
			"title": issue["title"],
			"url": issue.get("html_url"),
			"state": issue["state"],
			"status": status,
			"size": item.get("size") or "-",
			"priority": priority.get(number),
			"estimate": item.get("estimate"),
			"iteration": (item.get("iteration") or {}).get("title"),
			"assignees": [a["login"] for a in issue.get("assignees") or []],
			"item_id": item.get("id"),
			"has_children": has_children,
			"blocked_by": [b["number"] for b in blockers],
			"open_blockers": open_blockers,
			"pulls": [p["number"] for p in by_issue.get(number, [])],
			"draft_pull": bool(by_issue.get(number)) and all(p["isDraft"] for p in by_issue[number]),
			"merged": number in merged_issues,
			"ready": ready,
			"base": base if ready else None,
			"waiting_reason": reason,
		})

	summary = [{
		"number": p["number"], "head": p["headRefName"], "base": p["baseRefName"], "title": p["title"],
		"checks": checks(p), "review": p.get("reviewDecision") or "none", "draft": p["isDraft"],
		"reaches_base": chain(p["headRefName"]) is not None,
	} for p in stack]

	in_tree = {r["number"] for r in rows} | {PARENT}
	strays = [board[n] for n in board if n not in in_tree]
	drafts = [i for i in others if i.get("content", {}).get("type") == "DraftIssue"]
	return rows, summary, strays, drafts


def remote_branches():
	"""Issue numbers that have a `rearch/<issue>-…` branch on GitHub."""
	out = subprocess.run(["git", "ls-remote", "--heads", "origin", "rearch/*"], capture_output=True, text=True)
	if out.returncode != 0:
		# An empty set here would make every in-progress issue look abandoned.
		err = out.stderr.strip()
		sys.exit(f"git ls-remote failed: {err}{network_hint(err, 'check that `origin` is reachable and you can read it')}")
	found = set()
	for line in out.stdout.splitlines():
		ref = line.split("refs/heads/")[-1]
		m = BRANCH.match(ref)
		if m:
			found.add(int(m.group(1)))
	return found


def plan(rows, strays, drafts, branches):
	"""The moves the rules call for, and what needs a person's judgment."""
	moves = []
	notes = []
	by_number = {r["number"]: r for r in rows}
	children = {}
	for r in rows:
		children.setdefault(r["parent"], []).append(r)

	def wanted(r):
		if r["state"] == "closed":
			return "Done"
		if r["has_children"]:
			kids = children.get(r["number"], [])
			started = any(k["status"] in STARTED or k["state"] == "closed" for k in kids)
			if kids and all(k["state"] == "closed" for k in kids):
				notes.append(f"#{r['number']}: every sub-issue is closed; check its \"Done when\" and close it")
			return "In progress" if started else "Backlog"
		if r["pulls"]:
			return "In progress" if r["draft_pull"] else "In review"
		if r["merged"]:
			notes.append(f"#{r['number']}: its pull request merged; check its \"Done when\" and close it")
			return None
		if r["status"] == "Done":
			notes.append(f"#{r['number']}: open but marked Done; reopened, or closed by mistake?")
			return None
		if r["status"] in ("In progress", "In review"):
			if r["number"] in branches:
				if r["status"] == "In review":
					notes.append(f"#{r['number']}: In review, but its branch has no open pull request")
			else:
				notes.append(f"#{r['number']}: {r['status']}, but has no branch and no pull request; is anyone working it?")
			return None
		return "Ready" if r["ready"] else "Backlog"

	for r in rows:
		target = wanted(r)
		active = target in ("Ready", "In progress", "In review")
		if r["item_id"] is None:
			moves.append(("add", r, target or "Backlog"))
		elif target and target != r["status"]:
			moves.append(("status", r, target))
		if not r["assignees"] and r["state"] == "open":
			moves.append(("assign", r, MAINTAINER))
		if r["iteration"] is None and r["state"] == "open" and active and not r["has_children"]:
			moves.append(("iteration", r, None))
		if r["state"] == "open" and not r["has_children"]:
			missing = [name for name, absent in (
				("size", r["size"] == "-"),
				("priority", r["priority"] is None),
				("estimate", r["estimate"] is None),
			) if absent]
			if missing:
				notes.append(f"#{r['number']}: no {', no '.join(missing)}")
	for item in strays:
		notes.append(f"#{item['content']['number']}: on the board but not under #{PARENT}")
	for item in drafts:
		notes.append(f"draft \"{item['title']}\": waiting for the maintainer to review it and file it")
	return moves, notes


def maintain(apply):
	rows, _, strays, drafts = collect()
	moves, notes = plan(rows, strays, drafts, remote_branches())
	fields = project_fields() if apply and moves else None
	current = fields["current_iteration"] if fields else None

	print("Board moves" + ("" if apply else " (dry run; --apply to make them)") + "\n")
	if not moves:
		print("  none")
	for kind, r, value in moves:
		label = f"#{r['number']} {r['title'][:60]}"
		if kind == "add":
			line = f"  add to the board as {value}: {label}"
		elif kind == "status":
			line = f"  {r['status']} → {value}: {label}"
		elif kind == "assign":
			line = f"  assign {value}: {label}"
		else:
			line = f"  current iteration: {label}"
		print(line)
		if not apply:
			continue
		if kind == "add":
			added = gh("project", "item-add", str(PROJECT), "--owner", OWNER, "--url", r["url"], "--format", "json")
			# Later moves for this issue in the same run (such as its iteration) edit this item.
			r["item_id"] = added["id"]
			edit_status(fields, added["id"], value)
		elif kind == "status":
			edit_status(fields, r["item_id"], value)
		elif kind == "assign":
			subprocess.run(["gh", "issue", "edit", str(r["number"]), "-R", REPO, "--add-assignee", value],
				check=True, capture_output=True)
		elif kind == "iteration":
			if current is None or fields["iteration_field"] is None:
				print("    skipped: no iteration covers today")
				continue
			subprocess.run(["gh", "project", "item-edit", "--project-id", fields["project"], "--id", r["item_id"],
				"--field-id", fields["iteration_field"], "--iteration-id", current["id"]],
				check=True, capture_output=True)

	print("\nNeeds a person's judgment\n")
	if not notes:
		print("  nothing")
	for note in notes:
		print(f"  {note}")


def show(as_json):
	rows, summary, _, _ = collect()
	if as_json:
		json.dump({"issues": rows, "pull_requests": summary}, sys.stdout, indent=1)
		print()
		return

	print(f"Issues under #{PARENT}\n")
	print(f"{'':2}{'issue':<7}{'status':<13}{'prio':<8}{'size':<5}{'est':>5}  {'PR':<8}{'blocked by':<26}title")
	for r in rows:
		mark = "✓" if r["state"] == "closed" else ("→" if r["ready"] else " ")
		blocked = ",".join(f"#{n}" for n in r["open_blockers"]) or "-"
		prs = ",".join(f"#{n}" for n in r["pulls"]) or "-"
		est = "-" if r["estimate"] is None else f"{r['estimate']:g}"
		line = (f"{mark:2}{'#' + str(r['number']):<7}{r['status']:<13}{r['priority'] or '-':<8}{r['size']:<5}"
			f"{est:>5}  {prs:<8}{blocked:<26}{'  ' * r['depth']}{r['title']}")
		if r["ready"]:
			line += f"  [start from {r['base']}]"
		elif r["state"] == "open" and not r["pulls"] and r["waiting_reason"]:
			line += f"  [{r['waiting_reason']}]"
		print(line)
	print("\n→ ready to start   ✓ closed   est: the maintainer's estimate in hours")
	leaves = [r for r in rows if r["state"] == "open" and not r["has_children"]]
	estimated = [r for r in leaves if r["estimate"] is not None]
	remaining = sum(r["estimate"] for r in estimated)
	line = f"Estimated hours left: {remaining:g}, over {len(estimated)} of the {len(leaves)} open issues without sub-issues"
	if len(estimated) < len(leaves):
		line += f"; {len(leaves) - len(estimated)} have no estimate"
	print(line)

	print("\nOpen pull requests\n")
	if not summary:
		print("  none")
	for p in sorted(summary, key=lambda p: p["number"]):
		notes = []
		if p["draft"]:
			notes.append("draft")
		if not p["reaches_base"]:
			notes.append("does not reach rearchitecture")
		extra = f" ({', '.join(notes)})" if notes else ""
		print(f"  #{p['number']} {p['head']} → {p['base']}  checks: {p['checks']}  review: {p['review']}{extra}")


def main():
	args = sys.argv[1:]
	if args[:1] in (["-h"], ["--help"], ["help"]):
		print(__doc__.strip())
	elif args[:1] == ["status"]:
		if len(args) != 3 or not args[1].lstrip("#").isdigit():
			sys.exit('usage: tools/board status <issue> "<status>"')
		set_status(int(args[1].lstrip("#")), args[2])
	elif args[:1] == ["maintain"]:
		if any(a != "--apply" for a in args[1:]):
			sys.exit("usage: tools/board maintain [--apply]")
		maintain("--apply" in args[1:])
	else:
		show("--json" in args)


if __name__ == "__main__":
	main()
