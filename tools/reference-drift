#!/usr/bin/env bash
# Reports how the reference checkout differs from the commit that
# docs/reference/ describes.
#
# Exit status:
#   0  the reference is clean and at the recorded commit
#   1  it has moved, or has local modifications
#   2  the recorded commit cannot be found
#   3  the recorded commit is not an ancestor of the reference's head
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
ref=$("$here/reference-path")
pin=$(tr -d '[:space:]' <"$here/../docs/reference/REFERENCE_COMMIT")
status=0

if [[ -n "$(git -C "$ref" status --porcelain)" ]]; then
	echo "The reference checkout has local modifications. It must stay read-only:"
	git -C "$ref" status --short
	echo
	status=1
fi

if ! git -C "$ref" cat-file -e "$pin^{commit}" 2>/dev/null; then
	echo "recorded commit $pin is not in the reference checkout" >&2
	exit 2
fi

head=$(git -C "$ref" rev-parse HEAD)
if [[ "$head" == "$pin" ]]; then
	echo "reference is at the recorded commit $pin"
	exit $status
fi

if ! git -C "$ref" merge-base --is-ancestor "$pin" "$head"; then
	echo "The reference's head $head does not contain the recorded commit $pin."
	echo "It was rewritten or a different branch is checked out. Stop and ask."
	exit 3
fi

echo "recorded: $pin"
echo "head:     $head"
echo
echo "Every changed file, including configuration, tests and fixtures:"
git -C "$ref" diff --stat=200 "$pin..$head"
echo
echo "Changed files cited by docs/reference/:"
cited=$(grep -o -h -E '(workers|source|scripts)/[A-Za-z0-9_./-]+\.[a-z]+|wrangler\.jsonc|package\.json|README\.md' \
	"$here/../docs/reference/"*.md "$here/../docs/reference/"*.toml | sort -u)
changed=$(git -C "$ref" diff --name-only "$pin..$head")
comm -12 <(echo "$cited") <(echo "$changed" | sort -u) | sed 's/^/  /' || true
echo
echo "Changed conversion fixtures and generator modules:"
fixtures="$here/../fixtures/ccc-server"
fixture_paths=$(
	cd "$fixtures"
	find source workers -type f -print
	cat REFERENCE_CONVERSIONS
)
# Disable rename detection so a fixture moved out of its recorded path is reported.
fixture_changes=$(git -C "$ref" diff --name-only --no-renames "$pin..$head")
comm -12 <(printf '%s\n' "$fixture_paths" | sort -u) \
	<(printf '%s\n' "$fixture_changes" | sort -u) | sed 's/^/  /'
echo
echo "Commits, including merges:"
git -C "$ref" log --oneline "$pin..$head"
exit 1
