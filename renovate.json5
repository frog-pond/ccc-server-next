{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommitsDisabled',
    ':maintainLockFilesWeekly',
    'helpers:pinGitHubActionDigests',
  ],
  packageRules: [
    {
      matchPackageNames: ['wasm-bindgen-test', 'wasm-bindgen/wasm-bindgen'],
      groupName: 'wasm-bindgen test runner and crate',
    },
  ],
}
